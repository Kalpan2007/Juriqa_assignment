.env.*
!.env.example
*.pem
*.key

# --- dependencies ----------------------------------------------------------
node_modules/
.npm/

# --- build output ----------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo
client/.next/
client/out/
server/dist/
shared/dist/

