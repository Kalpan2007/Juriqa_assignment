# =============================================================================
# Contract Analyzer — environment template
# =============================================================================
# ONE file for both workspaces (ARCHITECTURE.md section 3.2 / decision D24).
#
#   cp .env.example .env     then fill in the real values below
#
# The server reads this file via ConfigModule(envFilePath), the client via
# dotenv in next.config.ts. Env is validated with zod at boot: the server
# REFUSES TO START if anything here is missing or malformed.
#
# .env is LOCAL ONLY and is gitignored — never commit it. On Render, set these
# in each service's Environment settings instead; no .env is deployed.
# Values marked (secret) must never appear in the client bundle or in git.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Runtime
# -----------------------------------------------------------------------------
# development | production | test
NODE_ENV=development

# Server port. Deliberately NOT named PORT: both apps share this one file, and a
# bare PORT would collide with the client's. Render injects a per-service PORT
# which takes priority over this in production.
SERVER_PORT=3001

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Browser origin allowed by CORS. Exactly the client's URL, no trailing slash.
# Local: http://localhost:3000   Production: https://<your-client>.onrender.com
WEB_ORIGIN=http://localhost:3000


# -----------------------------------------------------------------------------
# 2. Database — Supabase Postgres (secret)
# -----------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string
#   * Use the SESSION POOLER string on PORT 5432.
#   * Do NOT use the Direct connection (IPv6-only, unreachable from Render).
#   * Do NOT use the Transaction pooler (port 6543) — it breaks prepared
#     statements and migrations.
# Copy the string from the dashboard rather than assembling it by hand, then
# append the query params below.
#
# Shape:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres
#
# Required params (decision D16 — connection budget):
#   connection_limit=4   Prisma pool; pg-boss adds 2 more = 6 per instance
#   pool_timeout=20
#   sslmode=require
#
# If your DB password contains @ : / ? # or &, URL-encode it (@ -> %40).
DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?connection_limit=4&pool_timeout=20&sslmode=require

# Optional, LOCAL DEV ONLY. There is intentionally no DIRECT_URL (decision D15).
# Uncomment only if `prisma migrate dev` cannot create its shadow database.
# SHADOW_DATABASE_URL=


# -----------------------------------------------------------------------------
# 3. File storage — Supabase Storage (secret)
# -----------------------------------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://your_project_ref.supabase.co

# (secret) The SERVICE ROLE key — bypasses row-level security, server only.
# Never the anon key, and never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Create this bucket in Dashboard -> Storage and keep it PRIVATE.
SUPABASE_BUCKET=contracts


# -----------------------------------------------------------------------------
# 4. LLM — Groq, OpenAI-compatible (secret)
# -----------------------------------------------------------------------------
# (secret) console.groq.com/keys — starts with gsk_
LLM_API_KEY=your_groq_api_key

# OpenAI-compatible endpoint. Swapping provider = changing these three values.
LLM_BASE_URL=https://api.groq.com/openai/v1

# CONFIRM the exact id against console.groq.com/docs/models before first run —
# model ids change. Pick an inexpensive one (the assignment does not assess
# model quality). Suggested: openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-20b

# Input-token ceiling the budgeter is allowed to fill with excerpts + history,
# BEFORE the output reserve. Keep well under the model's context window and TPM budget.
# For Groq on-demand / free tier (8,000 TPM limit), set to 5500.
LLM_MAX_INPUT_TOKENS=5500

# Tokens-per-minute ceiling for the in-process rate limiter. Set this to your
# actual Groq TPM limit for the chosen model (console -> Settings -> Limits).
# For Groq on-demand / free tier, set to 7500.
LLM_TPM_BUDGET=7500


# -----------------------------------------------------------------------------
# 5. Upload limits
# -----------------------------------------------------------------------------
# Rejected above this with a message that states the limit.
MAX_UPLOAD_MB=25

# Page ceiling (decision D23). The assignment's bar is 150 pages.
MAX_PAGES=300


# -----------------------------------------------------------------------------
# 6. Client (public — compiled into the browser bundle, so NEVER a secret)
# -----------------------------------------------------------------------------
# Base URL of the server, no trailing slash.
# Local: http://localhost:3001   Production: https://<your-server>.onrender.com
#
# Next.js inlines NEXT_PUBLIC_* AT BUILD TIME (decision D18): changing this
# means rebuilding/redeploying the client, not just restarting it.
NEXT_PUBLIC_API_URL=http://localhost:3001
