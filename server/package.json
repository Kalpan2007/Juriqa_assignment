{
  "name": "@ca/server",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API: REST + SSE, pg-boss worker, Prisma, Supabase Storage, Groq LLM",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && nest build -p tsconfig.build.json",
    "dev": "nest start --watch --path tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "smoke:pdf": "tsx scripts/smoke-pdf.ts",
    "smoke:db": "tsx scripts/smoke-db.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ca/shared": "*",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "2.117.2",
    "dotenv": "17.2.4",
    "helmet": "8.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "nestjs-pino": "5.3.0",
    "node-html-parser": "^9.0.4",
    "openai": "7.27.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.16.3",
    "pg-boss": "11.1.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "^2.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "^1.16.13",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/pg": "8.16.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "unplugin-swc": "^2.0.0",
    "vitest": "3.2.7"
  }
}
